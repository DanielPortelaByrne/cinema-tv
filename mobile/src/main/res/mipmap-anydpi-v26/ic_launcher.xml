<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the Cinema mark's outer ring fills the 72 dp circle the launcher crops to; the maroon ground only shows
     where a launcher uses a squarer mask. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_ground" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
    <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
