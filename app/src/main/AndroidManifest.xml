<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice search (asked for at runtime, the first time the mic is used). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- So SpeechRecognizer can find the TV's speech service (package visibility, Android 11+). -->
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <package android:name="com.stremio.one" />
    </queries>

    <!-- Lets the launcher's Continue watching row read what is part-watched here (see ContinueWatchingProvider). -->
    <!-- ${applicationId} so the CI build (".ci" suffix) can sit beside the owner's copy. -->
    <permission
        android:name="${applicationId}.permission.CONTINUE_WATCHING"
        android:label="Read Cinema's Continue watching"
        android:protectionLevel="normal" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Home servers are usually plain http on the local network. -->
    <application
        android:name=".CinemaApp"
        android:largeHeap="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/ic_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Cinema">

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Cinema" />

        <activity
            android:name=".ui.music.MusicPlayerActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Cinema" />

        <activity
            android:name=".CinemaActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.Cinema">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Another app opens a Continue watching row here, with the row's key in the "key" extra. -->
            <intent-filter>
                <action android:name="${applicationId}.action.RESUME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name=".data.ContinueWatchingProvider"
            android:authorities="${applicationId}.continuewatching"
            android:exported="true"
            android:readPermission="${applicationId}.permission.CONTINUE_WATCHING" />
    </application>
</manifest>
